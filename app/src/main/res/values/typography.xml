<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Incremento 1 — tipografía editorial (DEC-003): serif del sistema para títulos
         editoriales y sans-serif funcional para el resto, sin fuentes embebidas.
         Las alturas de línea se expresan como lineSpacingExtra sobre el tamaño base. -->
    <style name="TextAppearance.BibliotecaIA" parent="android:TextAppearance.DeviceDefault">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/bia_text</item>
        <item name="android:textStyle">normal</item>
    </style>
    <!-- Título editorial: serif 24sp/30sp, 400. -->
    <style name="TextAppearance.BibliotecaIA.EditorialTitle">
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">24sp</item>
        <item name="android:lineSpacingExtra">6sp</item>
    </style>
    <!-- Título de libro / sección: sans-serif 16sp/22sp, 600. -->
    <style name="TextAppearance.BibliotecaIA.BookTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">6sp</item>
    </style>
    <style name="TextAppearance.BibliotecaIA.SectionTitle" parent="TextAppearance.BibliotecaIA.BookTitle" />
    <!-- Cuerpo: sans-serif 14sp/20sp, 400. -->
    <style name="TextAppearance.BibliotecaIA.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">6sp</item>
    </style>
    <!-- Acción: sans-serif-medium 14sp/20sp, 500. -->
    <style name="TextAppearance.BibliotecaIA.Action">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">6sp</item>
    </style>
    <!-- Metadatos: 12sp/17sp. -->
    <style name="TextAppearance.BibliotecaIA.Meta">
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">5sp</item>
    </style>
    <!-- Navegación: 12sp/16sp. -->
    <style name="TextAppearance.BibliotecaIA.NavLabel">
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>
    <!-- Título de diálogo (CMP-010): 20sp/26sp. -->
    <style name="TextAppearance.BibliotecaIA.DialogTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">6sp</item>
    </style>
</resources>
