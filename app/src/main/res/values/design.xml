    <style name="Widget.BibliotecaIA.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="chipBackgroundColor">@color/bia_surface</item>
        <item name="chipStrokeColor">@color/bia_outline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="chipMinHeight">42dp</item>
        <item name="android:textColor">@color/bia_text</item>
    </style>
    <style name="Widget.BibliotecaIA.NavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>
</resources>