<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bia_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.javierrb35.bibliotecaia.ui.EditorialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/organize_title"
            android:textSize="33sp"
            android:fontFamily="serif"
            android:textColor="@color/bia_text"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:text="@string/organize_section_categories"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/bia_accent" />

        <Button
            android:id="@+id/btnAddCategory"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/organize_add"
            android:textColor="@color/bia_accent" />

        <LinearLayout
            android:id="@+id/listCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/organize_section_tags"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/bia_accent" />

        <Button
            android:id="@+id/btnAddTag"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/organize_add"
            android:textColor="@color/bia_accent" />

        <LinearLayout
            android:id="@+id/listTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/organize_section_collections"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/bia_accent" />

        <Button
            android:id="@+id/btnAddCollection"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/organize_add"
            android:textColor="@color/bia_accent" />

        <LinearLayout
            android:id="@+id/listCollections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>
