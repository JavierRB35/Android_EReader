<?xml version="1.0" encoding="utf-8"?>
<!-- The normal phone layout fits in one viewport. Scrolling is retained only
     for unusually short screens / large accessibility font sizes. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bookDetailScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bia_background"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/txtDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="25sp"
            android:fontFamily="serif"
            android:textColor="@color/bia_text" />

        <TextView
            android:id="@+id/txtDetailAuthors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="15sp"
            android:textColor="@color/bia_text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtDetailFormat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:background="@drawable/bg_book_detail_chip"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/bia_accent" />

            <TextView
                android:id="@+id/txtDetailSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textSize="12sp"
                android:textColor="@color/bia_text_secondary" />

            <TextView
                android:id="@+id/txtDetailAdded"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textSize="12sp"
                android:textColor="@color/bia_text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/btnCycleStatus"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="10dp"
                android:background="@drawable/bg_book_detail_row"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_status"
                    android:textSize="12sp"
                    android:textColor="@color/bia_text_secondary" />

                <TextView
                    android:id="@+id/txtDetailStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="@color/bia_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="22sp"
                    android:textColor="@color/bia_accent" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnFavorite"
                android:layout_width="124dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_book_detail_row"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:textSize="13sp"
                android:textColor="@color/bia_text"
                android:text="@string/detail_favorite_short" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtDetailFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:ellipsize="middle"
            android:textSize="11sp"
            android:textColor="@color/bia_text_secondary" />

        <Button
            android:id="@+id/btnLink"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:minHeight="48dp"
            android:text="@string/detail_link"
            android:textColor="@color/bia_accent"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRemoveLocalCopy"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:text="@string/detail_remove_local_button"
            android:textAllCaps="false"
            android:textColor="@color/bia_text_secondary"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteBook"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:text="@string/detail_delete_book_button"
            android:textAllCaps="false"
            android:textColor="@color/bia_text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detail_organization_title"
                android:textAllCaps="true"
                android:letterSpacing="0.07"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="@color/bia_text" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="@string/detail_organization_hint"
                android:textSize="11sp"
                android:textColor="@color/bia_text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnEditCategories"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_book_detail_row"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_categories"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/bia_text" />
                <TextView
                    android:id="@+id/txtDetailCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="12sp"
                    android:textColor="@color/bia_text_secondary" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textSize="23sp"
                android:textColor="@color/bia_accent"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnEditTags"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_book_detail_row"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_tags"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/bia_text" />
                <TextView
                    android:id="@+id/txtDetailTags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="12sp"
                    android:textColor="@color/bia_text_secondary" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textSize="23sp"
                android:textColor="@color/bia_accent"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnEditCollections"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_book_detail_row"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_collections"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/bia_text" />
                <TextView
                    android:id="@+id/txtDetailCollections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="12sp"
                    android:textColor="@color/bia_text_secondary" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textSize="23sp"
                android:textColor="@color/bia_accent"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- Book argument action follows Organization as requested. -->
        <LinearLayout
            android:id="@+id/btnSynopsis"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_book_detail_row"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/detail_synopsis_add">
            <TextView
                android:id="@+id/txtSynopsisAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/detail_synopsis_add"
                android:textColor="@color/bia_text"
                android:textSize="14sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/bia_accent"
                android:textSize="22sp"
                android:importantForAccessibility="no"/>
        </LinearLayout>

        <!-- Keep the reading actions at the bottom when the viewport is tall. -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReadBook"
            app:cornerRadius="18dp"
            app:backgroundTint="@color/bia_accent"
            android:textColor="@color/bia_background"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="9dp"
            android:text="@string/action_read_book"
            android:textAllCaps="false"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAi"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:cornerRadius="15dp"
                app:strokeColor="@color/bia_accent_low"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/detail_ai"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/bia_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditMetadata"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:cornerRadius="15dp"
                app:strokeColor="@color/bia_accent_low"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/btn_edit_metadata"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/bia_text" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>