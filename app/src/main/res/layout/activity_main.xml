<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bia_background" android:orientation="vertical"
    android:paddingTop="4dp">

    <!-- Contextual toolbar replaces the normal masthead during selection. -->
    <LinearLayout android:id="@+id/bookSelectionBar" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="48dp" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="12dp"
        android:visibility="gone">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnClearBookSelection"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="Cerrar"
            android:textAllCaps="false" android:contentDescription="Cerrar selección"/>
        <TextView android:id="@+id/txtSelectedBooks" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="16sp" android:textStyle="bold" android:textColor="@color/bia_text"
            android:accessibilityLiveRegion="polite" android:gravity="center_vertical"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSelectAllBooks"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="Todos"
            android:textAllCaps="false" android:contentDescription="Seleccionar todos los resultados"/>
    </LinearLayout>

    <!-- Editorial masthead: compact tools, no redundant import action. -->
    <LinearLayout android:id="@+id/libraryNormalHeader" android:layout_width="match_parent" android:layout_height="48dp"
        android:paddingStart="20dp" android:paddingEnd="16dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="28dp" android:layout_height="28dp"
            android:src="@drawable/ic_read" android:contentDescription="@null"/>
        <!-- One editorial title row instead of a repeated brand + heading. -->
        <TextView android:id="@+id/txtTitle"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp"
            android:text="@string/library_title" android:fontFamily="serif"
            android:textStyle="bold" android:textSize="24sp" android:textColor="@color/bia_text"
            android:maxLines="1" android:ellipsize="end"
            android:accessibilityHeading="true"/>
        <ImageButton android:id="@+id/btnOrganize" android:layout_width="48dp"
            android:layout_height="48dp" android:padding="12dp"
            android:src="@drawable/ic_ux_organize" android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/bia_ux_organize_a11y"/>
        <ImageButton android:id="@+id/btnSettings" android:layout_width="48dp"
            android:layout_height="48dp" android:padding="12dp"
            android:src="@drawable/ic_ux_settings" android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_settings"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp">
        <LinearLayout android:id="@+id/libraryQuickActions" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical">
        <!-- Compact continuation shortcut: library shelf remains the main content. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/recentBookCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="7dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="13dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/bia_surface"
            app:strokeColor="@color/bia_outline"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="9dp"
                android:paddingEnd="6dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:importantForAccessibility="noHideDescendants">
                <FrameLayout
                    android:id="@+id/recentCoverThumb"
                    android:layout_width="32dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_premium_cover">
                    <TextView
                        android:id="@+id/txtRecentCoverFallback"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:padding="3dp"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:fontFamily="serif"
                        android:textColor="@color/bia_text"
                        android:textSize="8sp"/>
                    <ImageView
                        android:id="@+id/imgRecentCover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null"/>
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="11dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/bia_ux_continue"
                        android:textColor="@color/bia_accent"
                        android:textSize="9sp"
                        android:letterSpacing="0.08"/>
                    <TextView
                        android:id="@+id/txtRecentBook"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/bia_text"/>
                    <TextView
                        android:id="@+id/txtRecentProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="10sp"
                        android:textColor="@color/bia_text_secondary"/>
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/recentProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:max="100"
                        app:trackThickness="2dp"
                        app:indicatorColor="@color/bia_accent"
                        app:trackColor="@color/bia_outline"/>
                </LinearLayout>
                <TextView
                    android:layout_width="44dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:gravity="center"
                    android:text="›"
                    android:textSize="27sp"
                    android:textColor="@color/bia_accent"
                    android:importantForAccessibility="no"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStorageSetup"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Configurar copia y sincronización" android:textAllCaps="false"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCentralLibrary"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/central_complete"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMissingOriginals"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/central_missing_title"
            android:textAllCaps="false"
            android:visibility="gone" />

        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/bia_ux_search_hint"
            app:boxBackgroundColor="@color/bia_surface" app:boxStrokeColor="@color/bia_field_stroke"
            app:boxCornerRadiusTopStart="@dimen/bia_radius_field" app:boxCornerRadiusTopEnd="@dimen/bia_radius_field"
            app:boxCornerRadiusBottomStart="@dimen/bia_radius_field" app:boxCornerRadiusBottomEnd="@dimen/bia_radius_field"
            app:startIconDrawable="@drawable/ic_premium_search" app:endIconMode="clear_text">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtSearch" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="text"
                android:imeOptions="actionSearch" android:singleLine="true"
                android:textSize="14sp" android:minHeight="48dp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <HorizontalScrollView android:id="@+id/searchSuggestions"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone" android:scrollbars="none">
            <LinearLayout android:id="@+id/searchSuggestionItems"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <HorizontalScrollView android:id="@+id/scrollShelves"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:scrollbars="none">
            <com.google.android.material.chip.ChipGroup android:id="@+id/chipShelves"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                app:singleSelection="true" app:selectionRequired="true" app:singleLine="true"
                app:chipSpacingHorizontal="6dp">
                <com.google.android.material.chip.Chip android:id="@+id/chipAll" style="@style/Widget.BibliotecaIA.Filter"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/shelf_all" android:checked="true"/>
                <com.google.android.material.chip.Chip android:id="@+id/chipFavorites" style="@style/Widget.BibliotecaIA.Filter"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/shelf_favorites"/>
                <com.google.android.material.chip.Chip android:id="@+id/chipPending" style="@style/Widget.BibliotecaIA.Filter"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/shelf_pending"/>
                <com.google.android.material.chip.Chip android:id="@+id/chipReading" style="@style/Widget.BibliotecaIA.Filter"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/shelf_reading"/>
                <com.google.android.material.chip.Chip android:id="@+id/chipFinished" style="@style/Widget.BibliotecaIA.Filter"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/shelf_finished"/>
                <com.google.android.material.chip.Chip android:id="@+id/chipAbandoned" style="@style/Widget.BibliotecaIA.Filter"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/shelf_abandoned"/>
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/txtBookCount" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:textSize="13sp" android:textColor="@color/bia_accent"
                android:accessibilityLiveRegion="polite"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSearchFilters"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="Filtros" android:textAllCaps="false"
                android:contentDescription="Filtros y ordenación de libros"/>
            <ImageButton android:id="@+id/btnViewMode" android:layout_width="48dp"
                android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_ux_list" android:padding="12dp" android:scaleType="fitCenter"
                android:contentDescription="@string/action_list"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/bookBatchProgress" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="center_vertical"
        android:visibility="gone">
        <TextView android:id="@+id/txtBookBatchProgress" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/bia_text" android:accessibilityLiveRegion="polite"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCancelBookBatch"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Detener"/>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:paddingStart="16dp" android:paddingEnd="16dp">
        <ScrollView android:id="@+id/txtEmpty" android:layout_width="match_parent"
            android:layout_height="match_parent" android:fillViewport="true"
            android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="vertical" android:gravity="center" android:padding="16dp">
                <TextView android:id="@+id/txtEmptyHeading" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/bia_empty"
                    android:textSize="23sp" android:fontFamily="serif"
                    android:textColor="@color/bia_text" android:gravity="center"
                    android:accessibilityHeading="true"/>
                <TextView android:id="@+id/txtEmptyDetail" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:text="@string/bia_empty_detail" android:textSize="14sp"
                    android:lineSpacingExtra="3dp" android:textColor="@color/bia_text_secondary"
                    android:gravity="center"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearFilters" style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:minHeight="48dp"
                    android:text="@string/bia_ux_clear_filters" android:visibility="gone"/>
            </LinearLayout>
        </ScrollView>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerBooks"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone" android:clipToPadding="false" android:paddingBottom="8dp"/>
    </FrameLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/importProgress" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:indeterminate="true"
        android:visibility="gone" app:indicatorColor="@color/bia_accent"/>

    <!-- Selection actions replace the bottom navigation; the catalogue keeps its full remaining height. -->
    <LinearLayout android:id="@+id/bookBatchActions" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="56dp" android:orientation="horizontal"
        android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginBottom="6dp"
        android:paddingStart="4dp" android:paddingEnd="4dp" android:gravity="center_vertical"
        android:background="@drawable/bg_premium_nav" android:visibility="gone">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnBatchPrimary"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1"
            android:textAllCaps="false"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnBatchSecondary"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1"
            android:textAllCaps="false" android:text="Retirar del dispositivo"/>
    </LinearLayout>

    <!-- Normal navigation is restored when selection ends. -->
    <include layout="@layout/premium_bottom_navigation"/>
</LinearLayout>
