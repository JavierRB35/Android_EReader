<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bia_background"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp">

    <!-- Short header: the tools are recognizable, but never compete with the book list. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/txtTitle"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/library_title" android:textSize="28sp" android:fontFamily="serif"
            android:textColor="@color/bia_text" android:maxLines="2" android:ellipsize="end"
            android:accessibilityHeading="true"/>
        <ImageButton android:id="@+id/btnOrganize"
            android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_ux_organize" android:padding="12dp"
            android:scaleType="fitCenter" android:contentDescription="@string/bia_ux_organize_a11y"/>
        <ImageButton android:id="@+id/btnSettings"
            android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_ux_settings" android:padding="12dp"
            android:scaleType="fitCenter" android:contentDescription="@string/action_settings"/>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/recentBookCard"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" android:visibility="gone"
        android:clickable="true" android:focusable="true"
        app:cardCornerRadius="14dp" app:cardElevation="0dp"
        app:cardBackgroundColor="@color/bia_surface"
        app:strokeColor="@color/bia_outline" app:strokeWidth="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="14dp" android:paddingEnd="14dp"
            android:paddingTop="10dp" android:paddingBottom="10dp"
            android:importantForAccessibility="noHideDescendants">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/bia_ux_continue" android:textColor="@color/bia_accent"
                    android:textSize="10sp" android:letterSpacing="0.12"/>
                <TextView android:id="@+id/txtRecentBook"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end"
                    android:textSize="15sp" android:textStyle="bold" android:textColor="@color/bia_text"/>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:text="@string/bia_ux_open_reader"
                android:textColor="@color/bia_accent" android:textSize="14sp" android:textStyle="bold"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="@string/bia_ux_search_hint"
        app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp"
        app:endIconMode="clear_text">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/txtSearch"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="text" android:singleLine="true" android:textSize="14sp"
            android:imeOptions="actionSearch"/>
    </com.google.android.material.textfield.TextInputLayout>

    <HorizontalScrollView android:id="@+id/scrollShelves"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:scrollbars="none" android:fillViewport="false">
        <com.google.android.material.chip.ChipGroup android:id="@+id/chipShelves"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            app:singleSelection="true" app:selectionRequired="true" app:singleLine="true">
            <com.google.android.material.chip.Chip android:id="@+id/chipAll" style="@style/Widget.BibliotecaIA.Filter"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/shelf_all" android:checked="true"/>
            <com.google.android.material.chip.Chip android:id="@+id/chipFavorites" style="@style/Widget.BibliotecaIA.Filter"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/shelf_favorites"/>
            <com.google.android.material.chip.Chip android:id="@+id/chipPending" style="@style/Widget.BibliotecaIA.Filter"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/shelf_pending"/>
            <com.google.android.material.chip.Chip android:id="@+id/chipReading" style="@style/Widget.BibliotecaIA.Filter"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/shelf_reading"/>
            <com.google.android.material.chip.Chip android:id="@+id/chipFinished" style="@style/Widget.BibliotecaIA.Filter"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/shelf_finished"/>
            <com.google.android.material.chip.Chip android:id="@+id/chipAbandoned" style="@style/Widget.BibliotecaIA.Filter"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/shelf_abandoned"/>
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Import has a 48dp touch target, but no longer reserves an entire bottom row. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/txtBookCount"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/bia_text_secondary" android:textSize="12sp"
            android:accessibilityLiveRegion="polite"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnImport"
            android:layout_width="wrap_content" android:layout_height="48dp"
            android:minHeight="48dp" android:insetTop="0dp" android:insetBottom="0dp"
            android:text="@string/action_import" android:textSize="13sp"
            app:cornerRadius="14dp"/>
        <ImageButton android:id="@+id/btnViewMode"
            android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_ux_list" android:padding="12dp" android:scaleType="fitCenter"
            android:contentDescription="@string/action_list"/>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <ScrollView android:id="@+id/txtEmpty"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:fillViewport="true" android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="vertical" android:gravity="center" android:padding="16dp">
                <TextView android:id="@+id/txtEmptyHeading"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/bia_empty" android:textSize="23sp"
                    android:fontFamily="serif" android:textColor="@color/bia_text"
                    android:gravity="center" android:accessibilityHeading="true"/>
                <TextView android:id="@+id/txtEmptyDetail"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:text="@string/bia_empty_detail"
                    android:textSize="14sp" android:lineSpacingExtra="3dp"
                    android:textColor="@color/bia_text_secondary" android:gravity="center"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnClearFilters"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:minHeight="48dp"
                    android:text="@string/bia_ux_clear_filters" android:visibility="gone"/>
            </LinearLayout>
        </ScrollView>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerBooks"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone" android:clipToPadding="false"
            android:paddingBottom="8dp"/>
    </FrameLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/importProgress"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:indeterminate="true" android:visibility="gone"/>
    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/mainNavigation"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/bia_background" app:menu="@menu/main_navigation"
        app:labelVisibilityMode="labeled"/>
</LinearLayout>
