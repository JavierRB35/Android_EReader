<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="5dp"
    android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/bia_surface" app:cardCornerRadius="@dimen/bia_radius_card" app:cardElevation="0dp" app:strokeWidth="0dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
        <FrameLayout android:layout_width="78dp" android:layout_height="117dp" android:background="@drawable/bg_premium_cover" android:clipToOutline="true">
            <LinearLayout android:id="@+id/coverFallback" android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="vertical" android:gravity="center" android:padding="3dp" android:importantForAccessibility="noHideDescendants">
                <com.javierrb35.bibliotecaia.ui.EditorialTextView android:id="@+id/txtCoverTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:fontFamily="serif" android:textSize="12sp" android:textColor="@color/bia_text" android:gravity="center" android:maxLines="4" android:ellipsize="end"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:text="@string/bia_no_cover" android:textColor="@color/bia_text_secondary" android:textAppearance="@style/TextAppearance.BibliotecaIA.Overline"/>
            </LinearLayout>
            <ImageView android:id="@+id/imgBookCover" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no"/>
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="16dp" android:orientation="vertical">
            <TextView android:id="@+id/txtBookFormat" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.BibliotecaIA.Overline" android:textColor="@color/bia_accent"/>
            <TextView android:id="@+id/txtBookTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.BibliotecaIA.BookTitle" android:textColor="@color/bia_text" android:maxLines="2" android:ellipsize="end"/>
            <TextView android:id="@+id/txtBookAuthors" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.BibliotecaIA.Meta" android:textColor="@color/bia_text_secondary" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/txtBookProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:textSize="11sp" android:textColor="@color/bia_text_secondary"/>
            <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/bookProgress" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:indeterminate="false" android:max="100" app:trackThickness="3dp" app:trackColor="@color/bia_outline"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
