<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/mainNavigation" android:layout_width="match_parent"
        android:layout_height="82dp" android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp" android:layout_marginBottom="6dp"
        android:background="@drawable/bg_premium_nav" android:gravity="center"
        android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp">
        <LinearLayout android:id="@+id/navLibrary" style="@style/Widget.BibliotecaIA.NavItem"
            android:contentDescription="@string/nav_library">
            <ImageView android:layout_width="25dp" android:layout_height="25dp"
                android:src="@drawable/ic_library" android:contentDescription="@null"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:layout_marginTop="5dp" android:text="@string/nav_library"
                android:textStyle="bold" android:textSize="11sp" android:textColor="@color/bia_accent"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navRead" style="@style/Widget.BibliotecaIA.NavItem"
            android:contentDescription="@string/nav_read">
            <ImageView android:layout_width="25dp" android:layout_height="25dp"
                android:src="@drawable/ic_read" android:contentDescription="@null"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:layout_marginTop="5dp" android:text="@string/nav_read"
                android:textSize="11sp" android:textColor="@color/bia_text_secondary"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/btnImport" style="@style/Widget.BibliotecaIA.NavItem"
            android:contentDescription="@string/action_import">
            <TextView android:id="@+id/txtImportIcon"
                android:layout_width="45dp" android:layout_height="45dp"
                android:background="@drawable/bg_premium_import" android:gravity="center"
                android:text="+" android:textSize="30sp" android:textColor="@color/bia_background"
                android:importantForAccessibility="no"/>
            <TextView android:id="@+id/txtImportLabel"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:layout_marginTop="1dp" android:text="@string/premium_import"
                android:textSize="11sp" android:textColor="@color/bia_text_secondary"
                android:importantForAccessibility="no"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navKnowledge" style="@style/Widget.BibliotecaIA.NavItem"
            android:contentDescription="@string/nav_knowledge">
            <ImageView android:layout_width="25dp" android:layout_height="25dp"
                android:src="@drawable/ic_note" android:contentDescription="@null"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:layout_marginTop="5dp" android:text="@string/nav_knowledge"
                android:textSize="11sp" android:textColor="@color/bia_text_secondary"
                android:singleLine="true" android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>
