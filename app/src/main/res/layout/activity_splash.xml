<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bia_brand_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <ImageView
            android:layout_width="148dp"
            android:layout_height="148dp"
            android:src="@drawable/ic_biblioteca_mark"
            android:contentDescription="@string/splash_brand_icon_description"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/splash_brand_main"
                android:textColor="@color/bia_brand_white"
                android:textSize="28sp"
                android:fontFamily="serif"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/splash_brand_ai"
                android:textColor="@color/bia_accent"
                android:textSize="28sp"
                android:fontFamily="serif"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="@string/splash_subtitle"
            android:textColor="@color/bia_brand_muted"
            android:textSize="14sp"/>

        <ProgressBar
            android:id="@+id/splashBackupProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="56dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/bia_accent"/>

        <TextView
            android:id="@+id/splashBackupStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/splash_backup_checking"
            android:textColor="@color/bia_brand_muted"
            android:textSize="12sp"
            android:accessibilityLiveRegion="polite"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="42dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_author_initials"
            android:textColor="@color/bia_brand_white"
            android:textSize="15sp"
            android:letterSpacing="0.22"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/splash_author_name"
            android:textColor="@color/bia_brand_muted"
            android:textSize="11sp"/>
    </LinearLayout>
</FrameLayout>
