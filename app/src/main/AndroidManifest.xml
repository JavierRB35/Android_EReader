<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required only for user-approved updates via Android's package installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Optional notifications on Android 13+; in-app checks work even if denied. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".BibliotecaApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BibliotecaIA">

        <!-- Only the private updates/ cache directory is shared with Android's installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.javierrb35.bibliotecaia.updates.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.BibliotecaIA.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.BookDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.OrganizeActivity"
            android:exported="false" />
        <activity android:name=".ui.KnowledgeActivity" android:exported="false" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
        <activity android:name=".ai.AiSetupActivity" android:exported="false" />
        <activity android:name=".ai.AiChatActivity" android:exported="false" />
        <activity android:name=".reader.epub.EpubReaderActivity" android:exported="false" />
        <activity android:name=".reader.pdf.PdfReaderActivity" android:exported="false" />
        <activity android:name=".reader.mobi.MobiReaderActivity" android:exported="false" />
        <service android:name=".reader.pdf.PdfRenderService" android:process=":pdf_renderer"
            android:isolatedProcess="true" android:exported="false" />
    </application>

</manifest>
